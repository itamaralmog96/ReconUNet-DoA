__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
.installed.cfg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
pyEnv/

# ---- IDEs / editors ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ---- Jupyter ----
.ipynb_checkpoints/

