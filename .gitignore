# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
.installed.cfg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
pyEnv/

# ---- IDEs / editors ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# ---- TensorBoard / W&B ----
runs/
tensorboard/
wandb/

# ---- Experiment artifacts (large, regenerable) ----
# Everything under experiments/runs/ is training output and must never enter
# git, with one exception: the canonical paper-results EVD-UNet checkpoint
# (evd_unet_denoising_model_20250929_015132.pth) is tracked because the
# analysis scripts in scripts/analysis/ load it by path.  Keep
# experiments/paper_figures/ because final plots are not regenerable without
# re-running the whole pipeline.
!experiments/runs/
experiments/runs/*
!experiments/runs/legacy/
experiments/runs/legacy/*
!experiments/runs/legacy/checkpoints/
experiments/runs/legacy/checkpoints/*
!experiments/runs/legacy/checkpoints/evd_unet_denoising_model_20250929_015132.pth
experiments/legacy_results/
data/rendered/
data/cache/

# ---- Generated scenes (regenerate on every machine via generate_scenes) --
data/scenes/

# ---- Large test fixtures (legacy HDF5 dumps, regenerable) ----
tests/fixtures/

# ---- Notebook large outputs / archives ----
notebooks/archive/
notebooks/exploration/*.h5
notebooks/exploration/*.npy

# ---- Model checkpoints anywhere ----
*.pth
*.pt
*.ckpt
*.safetensors
# Exception: canonical paper-results EVD-UNet weights (see experiments/runs/ block above).
!experiments/runs/legacy/checkpoints/evd_unet_denoising_model_20250929_015132.pth

# ---- OS ----
Thumbs.db
desktop.ini

# ---- Python virtual environments ----
DOA_env/
.venv/
venv/

# ---- Local scratch/data dumps (not for the repo) ----
Data/
test_output/

# ---- Revision results that ARE tracked (CSVs, HTML report, plots) ----------
# experiments/runs/* is ignored above; re-include the 2026-09-10 evaluation
# directory so the result CSVs, the standalone HTML report and the sweep
# figure ship with the code.  Checkpoints stay excluded by *.pt / *.pth.
!experiments/runs/eval_coherent_20260910/
experiments/runs/eval_coherent_20260910/driver.out

# ---- Training logs / detached-run output (10-30 MB per stage) -------------
experiments/runs/**/*.log
!experiments/runs/eval_coherent_20260910/*.log
*.out
nohup.out
*.tfevents.*

# ---- Rendered / cached data anywhere under data/ (regenerable) -------------
data/**/*.npy
data/**/*.h5
data/**/*.npz

# ---- Checkpoints (all formats, anywhere) -----------------------------------
*.ckpt
*.pt
*.pth

# ---- Manuscript / peer-review handoff bundle (not part of the code release)
ReconUNet_handoff_for_ClaudeCode/

# Tables/figures re-derived from the tracked CSVs (regenerable)
experiments/runs/eval_coherent_20260910/derived/

# ---- 2026-09-20 revision pipeline: results that MUST be tracked ------------
# (experiments/runs/* is ignored above; re-include the result directories and the
#  status logs; checkpoints, TensorBoard events and bulky training logs stay out)
!experiments/runs/revision2_20260920/
experiments/runs/revision2_20260920/*.log
!experiments/runs/revision2_20260920/status.log
experiments/runs/revision2_20260920/pipeline.pid
!experiments/runs/ablation_20260920/
experiments/runs/ablation_20260920/**/tb/
!experiments/runs/ablation_20260920/status.log
!experiments/runs/sweeps_20260920/
!experiments/runs/damusic_paper/
experiments/runs/damusic_paper/*
!experiments/runs/damusic_paper/k*_v2/
experiments/runs/damusic_paper/k*_v2/tb/
!experiments/runs/damusic_paper/status*.log
!experiments/runs/revision_retrain_20260906/
experiments/runs/revision_retrain_20260906/*
!experiments/runs/revision_retrain_20260906/status.log
!experiments/runs/autopush.log
experiments/runs/autopush.pid
